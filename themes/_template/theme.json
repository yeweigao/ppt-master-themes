          "wght": 400
        },
        "bold": {
          "source": "fonts/<Font>[wght].ttf",
          "wght": 700
        }
      },
      "fallback": "Georgia",
      "pitch_family": 18
    }
  ],
  "postexport": {
    "embed_fonts": false,
    "render_check": "on request or when validating an optional font variant"
  },
  "mirror": {
    "html_font_map": {
      "<CSS family>": "title"
    },
    "html_css_overrides": ""
  },
  "design_defaults": [
    "Describe a positive visual method and when it serves a page; these are Reference defaults, never user prohibitions or a closed capability list."
