    "text": "#111111",
    "secondary_text": "#555555",
    "border": "#DDDDDD"
  },
  "contextual_paint": {},
  "typography": {
    "font_family": "Arial, Helvetica, sans-serif",
    "title_family": "\"<Title font>\", Georgia, serif",
    "body_family": "Arial, Helvetica, sans-serif",
    "kicker_family": "Arial, Helvetica, sans-serif",
    "svg_stacks": {
      "title": "'<Title font>', Georgia, serif",
      "kicker": "Arial",
      "body": "Arial"
    },
    "ladders": {
      "a4": {
        "annotation": 15,
        "caption": 17,
        "body": 23,
        "lead": 28,
        "subtitle": 32,
        "heading_sm": 38,
        "title": 58,
        "display": 84,
        "hero": 148
      },
      "ppt169": {
        "annotation": 12,
        "caption": 14,
        "body": 18,
        "lead": 22,
        "subtitle": 25,
        "heading_sm": 30,
        "title": 44,
        "display": 64,
        "hero": 112
      }
    },
    "tracking_em": {
      "kicker": 0.2,
      "running_header": 0.18
    },
    "leading": {
      "body": 1.5,
      "lead": 1.4,
      "display": 1.12
    },
    "ladder_note": "Calibrated for physical A4 print (210 x 297 mm = 595.28 x 841.89 pt on the 1240 x 1754 authoring canvas, where 1 SVG unit = 0.48 pt). Never drop annotation/ticks below 14 units (6.7 pt) on A4; keep lead (28) clearly larger than body (22-24) so reading flow matches information importance."
  },
  "fonts": [
    {
      "family": "<Title font>",
      "role": "title",
      "license": "OFL-1.1",
      "license_file": "fonts/OFL-<Font>.txt",
      "url": "https://fonts.google.com/specimen/<Font>",
